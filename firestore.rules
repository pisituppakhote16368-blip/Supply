rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isValidString(val, maxLen) {
      return val is string && val.size() <= maxLen;
    }

    // Equipments collection
    match /equipments/{equipmentId} {
      allow read: if true;
      allow write: if true;
    }

    // Borrow Records collection
    match /borrow_records/{recordId} {
      allow read: if true;
      allow write: if true;
    }

    // Quota policies
    match /quota_policies/{policyId} {
      allow read: if true;
      allow write: if true;
    }

    // Default deny for anything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
